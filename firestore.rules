rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Motos collection: Anyone can read, only authenticated admin can create, update, or delete
    match /motos/{motoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Settings collection: Anyone can read, only authenticated admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
